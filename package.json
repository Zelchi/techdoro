{
    "name": "techdoro",
    "productName": "Techdoro",
    "version": "3.0.1",
    "description": "A simple Pomodoro timer with a task list for your desktop.",
    "private": true,
    "type": "module",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "build": "yarn typecheck && vite build",
        "preview": "vite preview",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "check": "biome ci . && yarn typecheck",
        "tauri": "tauri",
        "tauri:dev": "tauri dev --config tauri/tauri.conf.json",
        "tauri:build": "tauri build --config tauri/tauri.conf.json"
    },
    "keywords": [
        "pomodoro",
        "tauri",
        "solidjs"
    ],
    "author": {
        "name": "Zelchi",
        "email": "tininhakawaii@gmail.com"
    },
    "license": "MIT",
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-notification": "^2.4.0",
        "@tauri-apps/plugin-process": "2.3.1",
        "@tauri-apps/plugin-updater": "2.11.0",
        "solid-js": "1.9.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "26.5.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2",
        "vite-plugin-solid": "2.11.14"
    }
}
