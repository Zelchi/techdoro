{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Techdoro",
    "version": "3.0.5",
    "identifier": "com.zelchi.techdoro",
    "build": {
        "beforeDevCommand": "yarn dev",
        "beforeBuildCommand": "yarn build",
        "devUrl": "http://127.0.0.1:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Techdoro",
                "width": 500,
                "height": 600,
                "minWidth": 500,
                "minHeight": 600,
                "resizable": false,
                "decorations": false,
                "transparent": false,
                "backgroundColor": "#0a0a0a",
                "shadow": false,
                "visible": true,
                "devtools": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "category": "Utility",
        "shortDescription": "A simple Pomodoro timer with a task list for your desktop.",
        "longDescription": "Techdoro helps you focus with customizable Pomodoro cycles and a lightweight task list.",
        "publisher": "Zelchi",
        "license": "MIT",
        "homepage": "https://github.com/Zelchi/Techdoro",
        "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDNkU5NzY3ODYxMjdGRjAKUldUd2Z4S0daNWR1N0Y1d0l0RE5HcHJRYUlCRzhKWmJPcXd4S1QyMS8yU0xrTENPNWtpQ3F3dHYK",
            "endpoints": ["https://github.com/Zelchi/Techdoro/releases/latest/download/latest.json"],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
