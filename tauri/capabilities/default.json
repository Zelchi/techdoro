{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "main-capability",
    "description": "Capability for the main Techdoro window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "core:window:allow-hide",
        "core:window:allow-start-dragging",
        "notification:default",
        "process:default",
        "updater:default"
    ]
}
